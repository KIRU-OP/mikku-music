# Set these in your hosting environment. Never commit a real token.
BOT_TOKEN=replace_with_botfather_token\n# Optional: required for /auth and /unauth (your numeric Telegram user ID)\nOWNER_ID=123456789\nAUTH_STORE_PATH=data/auth.json\n# Persistent Go-port settings, sudo list, and bot-level block list\nFEATURE_STORE_PATH=data/features.json\n# Optional ffmpeg binary override\nFFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
DOWNLOAD_DIR=downloads
# Optional compatible resolver Worker fallback:
# WORKER_FALLBACK_API_URL=https://your-worker.workers.dev
# WORKER_FALLBACK_API_KEY=replace_me
# Optional cookie file you own and are authorized to use:
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
