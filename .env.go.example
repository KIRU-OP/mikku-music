# Set these in your hosting environment. Never commit a real token.
BOT_TOKEN=replace_with_botfather_token
YTDLP_PATH=yt-dlp
DOWNLOAD_DIR=downloads
# Optional compatible resolver Worker fallback:
# WORKER_FALLBACK_API_URL=https://your-worker.workers.dev
# WORKER_FALLBACK_API_KEY=replace_me
# Optional cookie file you own and are authorized to use:
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
